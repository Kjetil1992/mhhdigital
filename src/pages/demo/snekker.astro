---
// Demo: Halvorsen Snekker AS
// Viser hva MHH Digital kan bygge for håndverksbedrifter
---

<!doctype html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Halvorsen Snekker AS – Skreddersydde snekkerløsninger siden 1987. Kjøkken, bad, trapper og innredning i Telemark." />
  <title>Halvorsen Snekker AS</title>
  <style>
    /* ── Tokens ── */
    :root {
      --ink:    #131F16;
      --moss:   #1B3222;
      --sage:   #2C4C36;
      --birch:  #C8913A;
      --dust:   #EDE5D8;
      --page:   #F2EDE4;
      --stone:  #C4BAB0;
      --warm:   #7A6250;

      --bg:      var(--page);
      --fg:      var(--ink);
      --fg-muted:var(--warm);
      --surface: #E6DFD4;
      --bd:      var(--stone);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: var(--ink); --fg: var(--dust);
        --fg-muted: #8FAF96; --surface: var(--moss); --bd: var(--sage);
      }
    }
    :root[data-theme="dark"]  { --bg: var(--ink); --fg: var(--dust); --fg-muted: #8FAF96; --surface: var(--moss); --bd: var(--sage); }
    :root[data-theme="light"] { --bg: var(--page); --fg: var(--ink); --fg-muted: var(--warm); --surface: #E6DFD4; --bd: var(--stone); }

    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: system-ui, -apple-system, "Segoe UI", Helvetica, sans-serif; background: var(--bg); color: var(--fg); line-height: 1.6; overflow-x: hidden; }

    /* ── Type ── */
    .serif { font-family: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif; }
    .label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }

    /* ── Nav ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 48px;
      background: rgba(19,31,22,0.88);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(200,145,58,0.15);
    }
    .nav-logo { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: 1.05rem; color: var(--dust); text-decoration: none; letter-spacing: 0.04em; }
    .nav-logo em { color: var(--birch); font-style: normal; }
    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a { font-size: 0.75rem; letter-spacing: 0.13em; text-transform: uppercase; color: rgba(237,229,216,0.55); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--dust); }
    .nav-cta { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink); background: var(--birch); padding: 9px 22px; text-decoration: none; transition: background 0.2s; }
    .nav-cta:hover { background: #D8A04A; }

    /* ── Hero ── */
    .hero {
      min-height: 100vh; display: flex; flex-direction: column; justify-content: flex-end;
      padding: 0 48px 72px;
      background-color: var(--moss);
      background-image:
        repeating-linear-gradient(109deg, transparent, transparent 3px, rgba(255,255,255,0.018) 3px, rgba(255,255,255,0.018) 5px),
        repeating-linear-gradient(94deg, transparent, transparent 44px, rgba(255,255,255,0.007) 44px, rgba(255,255,255,0.007) 45px);
      position: relative;
    }
    .hero::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(19,31,22,0.25) 0%, transparent 45%, rgba(10,18,12,0.6) 100%);
    }
    .hero-inner { position: relative; max-width: 1400px; width: 100%; }
    .hero-eyebrow { color: var(--birch); display: block; margin-bottom: 20px; }
    .hero-title {
      font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif;
      font-size: clamp(4.5rem, 13vw, 15rem);
      line-height: 0.91;
      letter-spacing: -0.02em;
      color: var(--dust);
      margin-bottom: 48px;
      text-wrap: balance;
    }
    .hero-foot {
      display: flex; align-items: flex-end; justify-content: space-between; gap: 48px;
      border-top: 1px solid rgba(200,145,58,0.28); padding-top: 32px;
    }
    .hero-tagline { font-size: clamp(1rem, 1.8vw, 1.2rem); color: rgba(237,229,216,0.7); max-width: 480px; line-height: 1.6; }
    .hero-actions { display: flex; gap: 14px; flex-shrink: 0; }
    .btn { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; padding: 13px 30px; transition: background 0.2s, transform 0.15s; }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary { color: var(--ink); background: var(--birch); }
    .btn-primary:hover { background: #D8A04A; }
    .btn-ghost { color: var(--dust); border: 1px solid rgba(237,229,216,0.28); }
    .btn-ghost:hover { border-color: var(--dust); }

    /* ── Intro ── */
    .intro { padding: 120px 48px; background: var(--bg); }
    .intro-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; align-items: center; }
    .intro-left .label { color: var(--birch); display: block; margin-bottom: 16px; }
    .intro-h2 { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(2rem, 3.5vw, 3rem); line-height: 1.1; text-wrap: balance; }
    .intro-text { margin-top: 20px; color: var(--fg-muted); font-size: 1.02rem; line-height: 1.78; }
    .intro-text + .intro-text { margin-top: 14px; }
    .pullquote { border-left: 3px solid var(--birch); padding: 32px 40px; background: var(--surface); }
    .pullquote blockquote { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(1.2rem, 2.2vw, 1.65rem); line-height: 1.45; font-style: italic; color: var(--fg); }
    .pullquote cite { display: block; margin-top: 20px; font-style: normal; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-muted); }

    /* ── Services ── */
    .services { padding: 0 48px 120px; background: var(--bg); }
    .section-head { max-width: 1200px; margin: 0 auto 56px; border-bottom: 1px solid var(--bd); padding-bottom: 20px; }
    .section-head .label { color: var(--birch); display: block; margin-bottom: 8px; }
    .section-h2 { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.1; }
    .services-grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3,1fr); border: 1px solid var(--bd); }
    .svc { padding: 48px 40px; border-right: 1px solid var(--bd); border-bottom: 1px solid var(--bd); transition: background 0.22s; }
    .svc:nth-child(3n)   { border-right: none; }
    .svc:nth-child(n+4)  { border-bottom: none; }
    .svc:hover { background: var(--surface); }
    .svc-bar { width: 36px; height: 2px; background: var(--birch); margin-bottom: 28px; transition: width 0.28s; }
    .svc:hover .svc-bar  { width: 60px; }
    .svc-title { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: 1.35rem; margin-bottom: 10px; }
    .svc-desc  { font-size: 0.88rem; color: var(--fg-muted); line-height: 1.68; }

    /* ── Process ── */
    .process { background: var(--birch); padding: 96px 48px; }
    .process-inner { max-width: 1200px; margin: 0 auto; }
    .process .label { color: rgba(19,31,22,0.55); display: block; margin-bottom: 10px; }
    .process-h2 { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(1.8rem,3vw,2.8rem); color: var(--ink); margin-bottom: 60px; }
    .steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; }
    .step { background: rgba(19,31,22,0.09); padding: 40px 32px; }
    .step-n { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: 3.8rem; color: rgba(19,31,22,0.18); line-height: 1; margin-bottom: 20px; }
    .step-title { font-weight: 700; font-size: 0.92rem; letter-spacing: 0.04em; color: var(--ink); margin-bottom: 8px; }
    .step-desc  { font-size: 0.86rem; color: rgba(19,31,22,0.62); line-height: 1.62; }

    /* ── About ── */
    .about {
      background: var(--moss); padding: 120px 48px;
      background-image: repeating-linear-gradient(109deg, transparent, transparent 3px, rgba(255,255,255,0.01) 3px, rgba(255,255,255,0.01) 5px);
    }
    .about-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 5fr 4fr; gap: 96px; align-items: start; }
    .about .label { color: var(--birch); display: block; margin-bottom: 16px; }
    .about-h2 { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(1.8rem,3vw,2.8rem); color: var(--dust); margin-bottom: 28px; }
    .about-body { color: rgba(237,229,216,0.68); line-height: 1.82; font-size: 1rem; }
    .about-body p + p { margin-top: 14px; }
    .stats { display: flex; flex-direction: column; gap: 2px; }
    .stat { background: rgba(255,255,255,0.05); border: 1px solid rgba(200,145,58,0.2); padding: 32px; }
    .stat-n { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: 3.5rem; color: var(--birch); line-height: 1; margin-bottom: 6px; font-variant-numeric: tabular-nums; }
    .stat-l { font-size: 0.76rem; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(237,229,216,0.4); }

    /* ── Contact ── */
    .contact { background: var(--ink); padding: 120px 48px; }
    .contact-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 100px; align-items: start; }
    .contact .label { color: var(--birch); display: block; margin-bottom: 16px; }
    .contact-h2 { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: clamp(1.8rem,3vw,2.8rem); color: var(--dust); margin-bottom: 20px; }
    .contact-lead { color: rgba(237,229,216,0.58); line-height: 1.7; }
    .contact-items { margin-top: 48px; display: flex; flex-direction: column; gap: 26px; }
    .ci .label { color: rgba(237,229,216,0.3); margin-bottom: 4px; }
    .ci a, .ci p { color: var(--dust); text-decoration: none; font-size: 0.98rem; }
    .ci a:hover { color: var(--birch); }
    .form { display: flex; flex-direction: column; gap: 14px; }
    .fg { display: flex; flex-direction: column; gap: 7px; }
    .fg label { font-size: 0.72rem; letter-spacing: 0.11em; text-transform: uppercase; color: rgba(237,229,216,0.36); }
    .fg input, .fg textarea {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(237,229,216,0.1);
      color: var(--dust); padding: 13px 17px; font-size: 0.93rem; font-family: inherit;
      outline: none; transition: border-color 0.2s; resize: vertical;
    }
    .fg input:focus, .fg textarea:focus { border-color: var(--birch); }
    .fg input::placeholder, .fg textarea::placeholder { color: rgba(237,229,216,0.18); }

    /* ── Footer ── */
    footer {
      background: #0B130D; padding: 28px 48px;
      display: flex; align-items: center; justify-content: space-between;
      border-top: 1px solid rgba(200,145,58,0.1);
    }
    .foot-logo { font-family: "Palatino Linotype","Book Antiqua",Palatino,Georgia,serif; font-size: 0.9rem; color: rgba(237,229,216,0.35); }
    .foot-copy  { font-size: 0.76rem; color: rgba(237,229,216,0.2); }

    /* ── Demo badge ── */
    .demo-badge {
      position: fixed; bottom: 22px; right: 22px; z-index: 200;
      background: var(--ink); border: 1px solid rgba(200,145,58,0.4);
      padding: 10px 16px; text-align: center; text-decoration: none;
      box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    }
    .demo-badge .label { color: var(--birch); display: block; margin-bottom: 2px; }
    .demo-badge span { font-size: 0.78rem; color: rgba(237,229,216,0.55); }

    /* ── Responsive ── */
    @media (max-width: 900px) {
      nav { padding: 16px 24px; }
      .nav-links { display: none; }
      .hero { padding: 0 24px 56px; }
      .intro { padding: 80px 24px; }
      .intro-inner { grid-template-columns: 1fr; gap: 48px; }
      .services { padding: 0 24px 80px; }
      .services-grid { grid-template-columns: 1fr 1fr; }
      .svc:nth-child(3n)  { border-right: 1px solid var(--bd); }
      .svc:nth-child(2n)  { border-right: none; }
      .svc:nth-child(n+5) { border-bottom: none; }
      .svc:nth-child(-n+4){ border-bottom: 1px solid var(--bd); }
      .process { padding: 72px 24px; }
      .steps { grid-template-columns: 1fr 1fr; }
      .about { padding: 80px 24px; }
      .about-inner { grid-template-columns: 1fr; gap: 48px; }
      .stats { flex-direction: row; flex-wrap: wrap; }
      .stat { flex: 1 1 140px; }
      .contact { padding: 80px 24px; }
      .contact-inner { grid-template-columns: 1fr; gap: 56px; }
      footer { padding: 24px; flex-direction: column; gap: 6px; text-align: center; }
    }
    @media (max-width: 560px) {
      .hero-foot { flex-direction: column; align-items: flex-start; }
      .services-grid { grid-template-columns: 1fr; }
      .svc { border-right: none !important; border-bottom: 1px solid var(--bd) !important; }
      .svc:last-child { border-bottom: none !important; }
      .steps { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; } }
  </style>
</head>
<body>

  <nav>
    <a href="#" class="nav-logo">Halvorsen <em>Snekker</em></a>
    <ul class="nav-links">
      <li><a href="#tjenester">Tjenester</a></li>
      <li><a href="#om-oss">Om oss</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
    </ul>
    <a href="#kontakt" class="nav-cta">Be om tilbud</a>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <span class="label hero-eyebrow">Snekkerverksted · Notodden · Est. 1987</span>
      <h1 class="hero-title">Halvorsen<br>Snekker</h1>
      <div class="hero-foot">
        <p class="hero-tagline">Vi bygger kjøkken, trapper og innredning som holder i generasjoner. Tradisjoner og materialer du kan stole på.</p>
        <div class="hero-actions">
          <a href="#kontakt" class="btn btn-primary">Be om tilbud</a>
          <a href="#tjenester" class="btn btn-ghost">Tjenester</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <div class="intro-inner">
      <div>
        <span class="label" style="color:var(--birch);display:block;margin-bottom:16px;">Håndverk med sjel</span>
        <h2 class="intro-h2">Vi bygger<br>for å vare</h2>
        <p class="intro-text">Hos Halvorsen Snekker AS arbeider vi med de samme prinsippene som vi alltid har gjort: gode materialer, riktig teknikk og tid til å gjøre jobben ordentlig. Vi tar et begrenset antall oppdrag per år slik at hvert prosjekt får den oppmerksomheten det fortjener.</p>
        <p class="intro-text">Fra første møte til ferdig montering er det mennesker, ikke maskiner, som tar beslutningene. Vi setter stolthet i arbeidet — det merkes.</p>
      </div>
      <div class="pullquote">
        <blockquote>«Snekkeren er ferdig når kunden ikke lenger trenger oss — men husker oss likevel.»</blockquote>
        <cite>— Tor Halvorsen, grunnlegger</cite>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services" id="tjenester">
    <div class="section-head">
      <span class="label" style="color:var(--birch);">Tjenester</span>
      <h2 class="section-h2">Hva vi lager</h2>
    </div>
    <div class="services-grid">
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Kjøkken</h3><p class="svc-desc">Skreddersydde kjøkken etter dine mål og ønsker. Vi tegner, produserer og monterer — alt under ett tak.</p></div>
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Innredning</h3><p class="svc-desc">Garderober, bokhyller, TV-vegger og innebygde løsninger som utnytter plassen optimalt.</p></div>
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Trapper</h3><p class="svc-desc">Rett trapp, vindeltrapp eller svevende trappetrinn. Solid håndverk som er en del av arkitekturen.</p></div>
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Bad</h3><p class="svc-desc">Baderomsinnredning i tre og laminat. Robuste løsninger som tåler daglig bruk i fuktige omgivelser.</p></div>
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Restaurering</h3><p class="svc-desc">Eldre hus og møbler fortjener å leve videre. Vi restaurerer originale detaljer med respekt for håndverket.</p></div>
      <div class="svc"><div class="svc-bar"></div><h3 class="svc-title">Utvendig</h3><p class="svc-desc">Terrasser, garasjeporter, fasadekledning og uteboder. Bygget for norsk klima og lange vintre.</p></div>
    </div>
  </section>

  <!-- Process -->
  <section class="process">
    <div class="process-inner">
      <span class="label" style="color:rgba(19,31,22,0.55);display:block;margin-bottom:10px;">Slik jobber vi</span>
      <h2 class="process-h2">Fra idé til ferdig resultat</h2>
      <div class="steps">
        <div class="step"><div class="step-n">1</div><div class="step-title">Befaring</div><p class="step-desc">Vi møter deg hjemme, ser på plassen og lytter til hva du ønsker. Ingen forpliktelse.</p></div>
        <div class="step"><div class="step-n">2</div><div class="step-title">Tegning & tilbud</div><p class="step-desc">Vi tegner løsningen og sender et fast tilbud. Du vet hva du får og hva det koster.</p></div>
        <div class="step"><div class="step-n">3</div><div class="step-title">Produksjon</div><p class="step-desc">Alt lages på vår verksted i Notodden. Du er velkommen til å besøke oss underveis.</p></div>
        <div class="step"><div class="step-n">4</div><div class="step-title">Montering</div><p class="step-desc">Vi monterer, rydder og gjennomgår resultatet med deg. Vi er ikke ferdige før du er fornøyd.</p></div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="about" id="om-oss">
    <div class="about-inner">
      <div>
        <span class="label" style="color:var(--birch);display:block;margin-bottom:16px;">Om oss</span>
        <h2 class="about-h2">Familie og fag<br>siden 1987</h2>
        <div class="about-body">
          <p>Tor Halvorsen startet verkstedet sitt i en låve utenfor Notodden i 1987. I dag driver sønnen Magnus videre med de samme verdiene — men med moderne maskiner og bedre kaffemaskin.</p>
          <p>Vi er et lite verksted med seks ansatte, og det er vi med vilje. Det gir oss kontroll over kvaliteten i hvert eneste ledd, og betyr at du alltid snakker med noen som kjenner prosjektet ditt.</p>
          <p>Vi bruker primært norsk furu, gran og ask — treslag som er vokst frem i det samme klimaet som husene de skal inn i.</p>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><div class="stat-n">37</div><div class="stat-l">År i bransjen</div></div>
        <div class="stat"><div class="stat-n">6</div><div class="stat-l">Ansatte snekkere</div></div>
        <div class="stat"><div class="stat-n">800+</div><div class="stat-l">Prosjekter fullført</div></div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="kontakt">
    <div class="contact-inner">
      <div>
        <span class="label">Kontakt</span>
        <h2 class="contact-h2">La oss snakke om<br>prosjektet ditt</h2>
        <p class="contact-lead">Vi svarer på alle henvendelser innen én virkedag. Befaringer er gratis og uforpliktende.</p>
        <div class="contact-items">
          <div class="ci"><span class="label">Telefon</span><a href="tel:+4735012345">+47 35 01 23 45</a></div>
          <div class="ci"><span class="label">E-post</span><a href="mailto:post@halvorsensnekker.no">post@halvorsensnekker.no</a></div>
          <div class="ci"><span class="label">Adresse</span><p>Industriveien 12, 3674 Notodden</p></div>
          <div class="ci"><span class="label">Åpningstider</span><p>Mandag–fredag 07:30–16:00</p></div>
        </div>
      </div>
      <div class="form">
        <div class="fg"><label>Navn</label><input type="text" placeholder="Ola Nordmann" /></div>
        <div class="fg"><label>E-post</label><input type="email" placeholder="ola@eksempel.no" /></div>
        <div class="fg"><label>Melding</label><textarea rows="5" placeholder="Beskriv kort hva du ønsker hjelp med..."></textarea></div>
        <button type="button" class="btn btn-primary" style="border:none;cursor:pointer;align-self:flex-start;">Send melding</button>
      </div>
    </div>
  </section>

  <footer>
    <span class="foot-logo">Halvorsen Snekker AS</span>
    <span class="foot-copy">© 2024 · Org.nr 987 654 321 · Notodden</span>
  </footer>

  <a href="https://mhhdigital.no" class="demo-badge">
    <span class="label">Demo</span>
    <span>Laget av MHH Digital</span>
  </a>

</body>
</html>
