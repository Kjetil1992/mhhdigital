---
import Layout from '../../layouts/Layout.astro';
import { getSupabase } from '../../lib/supabase';

const sb = getSupabase();
const now = new Date().toISOString();
const { data: posts } = await sb
  .from('posts')
  .select('title, slug, body, published_at, scheduled_at')
  .or(`published.eq.true,scheduled_at.lte.${now}`)
  .order('published_at', { ascending: false });
---

<Layout title="Blogg" description="Nyheter og innlegg fra MHH Digital">
  <section class="pt-32 pb-20 max-w-3xl mx-auto px-6">
    <h1 class="text-4xl font-bold mb-3">Blogg</h1>
    <p class="text-gray-400 mb-12">Nyheter, tips og oppdateringer fra MHH Digital</p>

    {!posts?.length ? (
      <p class="text-gray-500">Ingen innlegg publisert ennå — kom tilbake snart!</p>
    ) : (
      <div class="space-y-8">
        {posts.map((p: any) => (
          <a href={`/blogg/${p.slug}`} class="block group bg-gray-900/50 border border-gray-800 hover:border-emerald-800 rounded-2xl p-7 transition-colors">
            <p class="text-xs text-gray-500 mb-2">{new Date(p.published_at ?? p.scheduled_at).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2 class="text-xl font-bold mb-2 group-hover:text-emerald-400 transition-colors">{p.title}</h2>
            <p class="text-gray-400 text-sm leading-relaxed">{p.body.slice(0, 150)}{p.body.length > 150 ? '…' : ''}</p>
            <span class="inline-block mt-4 text-emerald-400 text-sm font-medium">Les mer →</span>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
