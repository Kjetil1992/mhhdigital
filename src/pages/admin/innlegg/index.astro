---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabase } from '../../../lib/supabase';

const sb = getSupabase();

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  await sb.from('posts').delete().eq('id', data.get('id'));
  return Astro.redirect('/admin/innlegg');
}

const { data: posts } = await sb.from('posts').select('*').order('created_at', { ascending: false });
---

<AdminLayout title="Innlegg">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold">Innlegg</h1>
    <a href="/admin/innlegg/ny" class="bg-cyan-500 hover:bg-cyan-400 text-gray-950 font-bold px-5 py-2.5 rounded-xl transition-colors text-sm">
      + Nytt innlegg
    </a>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
    {!posts?.length ? (
      <p class="text-gray-500 text-center py-16">Ingen innlegg ennå.</p>
    ) : (
      <table class="w-full text-sm">
        <thead class="border-b border-gray-800">
          <tr>
            <th class="text-left px-6 py-3 text-gray-400 font-medium">Tittel</th>
            <th class="text-left px-6 py-3 text-gray-400 font-medium">Status</th>
            <th class="text-left px-6 py-3 text-gray-400 font-medium">Dato</th>
            <th class="px-6 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {posts.map((p: any) => (
            <tr class="border-b border-gray-800 last:border-0 hover:bg-gray-800/50">
              <td class="px-6 py-4 font-medium">{p.title}</td>
              <td class="px-6 py-4">
                {p.published
                  ? <span class="bg-green-950 text-green-400 text-xs px-2.5 py-1 rounded-full">Publisert</span>
                  : <span class="bg-gray-800 text-gray-400 text-xs px-2.5 py-1 rounded-full">Kladd</span>
                }
              </td>
              <td class="px-6 py-4 text-gray-400">{new Date(p.created_at).toLocaleDateString('nb-NO')}</td>
              <td class="px-6 py-4 text-right flex items-center justify-end gap-4">
                <a href={`/admin/innlegg/${p.id}`} class="text-cyan-400 hover:text-cyan-300 transition-colors">Rediger</a>
                <form method="POST" class="inline" onsubmit="return confirm('Slett dette innlegget?')">
                  <input type="hidden" name="id" value={p.id} />
                  <button type="submit" class="text-red-500 hover:text-red-400 transition-colors">Slett</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>
