---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabase } from '../../../lib/supabase';

let errorMsg = '';
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const sb = getSupabase();
  const { error } = await sb.from('income').insert({
    description: data.get('description'),
    amount: Number(data.get('amount')),
    category: data.get('category'),
    date: data.get('date'),
    notes: data.get('notes') || null,
  });
  if (!error) return Astro.redirect('/admin/regnskap');
  errorMsg = error.message;
}

const today = new Date().toISOString().split('T')[0];
---

<AdminLayout title="Ny inntekt">
  <div class="max-w-xl">
    <h1 class="text-2xl font-bold mb-8">Ny inntekt</h1>
    {errorMsg && <div class="bg-red-950 border border-red-800 text-red-300 rounded-xl p-4 mb-4 text-sm">{errorMsg}</div>}
    <form method="POST" class="bg-gray-900 border border-gray-800 rounded-2xl p-8 space-y-5">
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1.5">Beskrivelse *</label>
        <input name="description" required placeholder="f.eks. Konsulentoppdrag kontant" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Beløp (kr) *</label>
          <input name="amount" type="number" min="0" step="0.01" required class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Dato *</label>
          <input name="date" type="date" required value={today} class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1.5">Kategori *</label>
        <select name="category" required class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500">
          <option value="konsulent">Konsulentoppdrag</option>
          <option value="salg">Salg</option>
          <option value="tilskudd">Tilskudd / støtte</option>
          <option value="annet">Annet</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1.5">Notat</label>
        <textarea name="notes" rows="2" placeholder="Valgfritt" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500 resize-none"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-gray-950 font-bold px-6 py-2.5 rounded-xl transition-colors">Lagre inntekt</button>
        <a href="/admin/regnskap" class="text-gray-400 hover:text-white px-6 py-2.5 transition-colors">Avbryt</a>
      </div>
    </form>
  </div>
</AdminLayout>
