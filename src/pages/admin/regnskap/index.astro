---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabase } from '../../../lib/supabase';

const sb = getSupabase();
const year = Number(Astro.url.searchParams.get('year') ?? new Date().getFullYear());

// Slett-handlinger
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');
  const id = data.get('id');
  if (action === 'delete_expense') await sb.from('expenses').delete().eq('id', id);
  if (action === 'delete_income') await sb.from('income').delete().eq('id', id);
  return Astro.redirect(`/admin/regnskap?year=${year}`);
}

const [{ data: expenses }, { data: manualIncome }, { data: paidInvoices }] = await Promise.all([
  sb.from('expenses').select('*').gte('date', `${year}-01-01`).lte('date', `${year}-12-31`).order('date', { ascending: false }),
  sb.from('income').select('*').gte('date', `${year}-01-01`).lte('date', `${year}-12-31`).order('date', { ascending: false }),
  sb.from('invoices').select('id, created_at, invoice_lines(unit_price, quantity)').eq('status', 'betalt').gte('created_at', `${year}-01-01`).lte('created_at', `${year}-12-31`),
]);

// MVA per kvartal
const quarters = [
  { label: 'Q1 (jan–mar)', months: [0, 1, 2] },
  { label: 'Q2 (apr–jun)', months: [3, 4, 5] },
  { label: 'Q3 (jul–sep)', months: [6, 7, 8] },
  { label: 'Q4 (okt–des)', months: [9, 10, 11] },
];
const vatByQuarter = quarters.map(q => {
  const net = (paidInvoices ?? [])
    .filter((inv: any) => q.months.includes(new Date(inv.created_at).getMonth()))
    .reduce((sum: number, inv: any) => {
      return sum + (inv.invoice_lines ?? []).reduce((s: number, l: any) => s + l.unit_price * l.quantity, 0);
    }, 0);
  return { label: q.label, net, mva: net * 0.25, total: net * 1.25 };
});

const invoiceIncome = (paidInvoices ?? []).reduce((sum: number, inv: any) => {
  const net = (inv.invoice_lines ?? []).reduce((s: number, l: any) => s + l.unit_price * l.quantity, 0);
  return sum + net * 1.25;
}, 0);

const manualIncomeTotal = (manualIncome ?? []).reduce((s: number, e: any) => s + e.amount, 0);
const totalIncome = invoiceIncome + manualIncomeTotal;
const totalExpenses = (expenses ?? []).reduce((s: number, e: any) => s + e.amount, 0);
const result = totalIncome - totalExpenses;

const expenseCategories: Record<string, string> = {
  programvare: 'Programvare', maskinvare: 'Maskinvare', kontor: 'Kontor',
  markedsforing: 'Markedsføring', reise: 'Reise', annet: 'Annet',
};
const incomeCategories: Record<string, string> = {
  konsulent: 'Konsulentoppdrag', salg: 'Salg', tilskudd: 'Tilskudd', annet: 'Annet',
};
---

<AdminLayout title="Regnskap">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold">Regnskap</h1>
      <p class="text-gray-400 text-sm mt-1">Oversikt over inntekter og utgifter</p>
    </div>
    <div class="flex items-center gap-3">
      <a href={`/admin/regnskap?year=${year - 1}`} class="text-gray-400 hover:text-white px-3 py-1.5 rounded-lg border border-gray-700 hover:border-gray-500 text-sm transition-colors">← {year - 1}</a>
      <span class="font-bold text-lg">{year}</span>
      <a href={`/admin/regnskap?year=${year + 1}`} class="text-gray-400 hover:text-white px-3 py-1.5 rounded-lg border border-gray-700 hover:border-gray-500 text-sm transition-colors">{year + 1} →</a>
    </div>
  </div>

  <!-- Sammendrag -->
  <div class="grid grid-cols-3 gap-5 mb-10">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
      <p class="text-gray-400 text-sm mb-1">Inntekter totalt</p>
      <p class="text-3xl font-bold text-green-400">{totalIncome.toLocaleString('nb-NO')} kr</p>
      {invoiceIncome > 0 && <p class="text-gray-500 text-xs mt-1">Fakturaer: {invoiceIncome.toLocaleString('nb-NO')} kr</p>}
      {manualIncomeTotal > 0 && <p class="text-gray-500 text-xs">Manuelt: {manualIncomeTotal.toLocaleString('nb-NO')} kr</p>}
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
      <p class="text-gray-400 text-sm mb-1">Utgifter</p>
      <p class="text-3xl font-bold text-red-400">{totalExpenses.toLocaleString('nb-NO')} kr</p>
    </div>
    <div class={`bg-gray-900 border rounded-2xl p-6 ${result >= 0 ? 'border-green-800' : 'border-red-800'}`}>
      <p class="text-gray-400 text-sm mb-1">Resultat</p>
      <p class={`text-3xl font-bold ${result >= 0 ? 'text-green-400' : 'text-red-400'}`}>{result >= 0 ? '+' : ''}{result.toLocaleString('nb-NO')} kr</p>
    </div>
  </div>

  <!-- Inntekter (manuelt) -->
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Inntekter {year} <span class="text-gray-500 text-sm font-normal">(utenom fakturaer)</span></h2>
    <a href="/admin/regnskap/ny-inntekt" class="bg-green-700 hover:bg-green-600 text-white font-bold px-4 py-2 rounded-xl text-sm transition-colors">+ Ny inntekt</a>
  </div>

  {(manualIncome ?? []).length === 0 ? (
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 text-center mb-8">
      <p class="text-gray-500 text-sm">Ingen manuelle inntekter registrert for {year}</p>
    </div>
  ) : (
    <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden mb-8">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-800">
          <tr>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Dato</th>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Beskrivelse</th>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Kategori</th>
            <th class="text-right py-3 px-5 text-gray-400 font-medium">Beløp</th>
            <th class="py-3 px-5"></th>
          </tr>
        </thead>
        <tbody>
          {(manualIncome ?? []).map((e: any) => (
            <tr class="border-b border-gray-800 hover:bg-gray-800/50 transition-colors">
              <td class="py-3 px-5 text-gray-400">{new Date(e.date).toLocaleDateString('nb-NO')}</td>
              <td class="py-3 px-5 font-medium">{e.description}</td>
              <td class="py-3 px-5"><span class="bg-green-950 text-green-400 text-xs px-2.5 py-1 rounded-full">{incomeCategories[e.category] ?? e.category}</span></td>
              <td class="py-3 px-5 text-right text-green-400 font-medium">{e.amount.toLocaleString('nb-NO')} kr</td>
              <td class="py-3 px-5 text-right">
                <form method="POST" class="inline" onsubmit="return confirm('Slett denne inntekten?')">
                  <input type="hidden" name="action" value="delete_income" />
                  <input type="hidden" name="id" value={e.id} />
                  <button type="submit" class="text-gray-600 hover:text-red-400 transition-colors text-xs">Slett</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot class="border-t-2 border-gray-700">
          <tr>
            <td colspan="3" class="py-3 px-5 text-gray-400 font-medium">Totalt</td>
            <td class="py-3 px-5 text-right font-bold text-green-400">{manualIncomeTotal.toLocaleString('nb-NO')} kr</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  )}

  <!-- Utgifter -->
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Utgifter {year}</h2>
    <a href="/admin/regnskap/ny" class="bg-cyan-500 hover:bg-cyan-400 text-gray-950 font-bold px-4 py-2 rounded-xl text-sm transition-colors">+ Ny utgift</a>
  </div>

  {(expenses ?? []).length === 0 ? (
    <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 text-center">
      <p class="text-gray-500 text-sm">Ingen utgifter registrert for {year}</p>
    </div>
  ) : (
    <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-800">
          <tr>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Dato</th>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Beskrivelse</th>
            <th class="text-left py-3 px-5 text-gray-400 font-medium">Kategori</th>
            <th class="text-right py-3 px-5 text-gray-400 font-medium">Beløp</th>
            <th class="py-3 px-5"></th>
          </tr>
        </thead>
        <tbody>
          {(expenses ?? []).map((e: any) => (
            <tr class="border-b border-gray-800 hover:bg-gray-800/50 transition-colors">
              <td class="py-3 px-5 text-gray-400">{new Date(e.date).toLocaleDateString('nb-NO')}</td>
              <td class="py-3 px-5 font-medium">{e.description}</td>
              <td class="py-3 px-5"><span class="bg-gray-800 text-gray-300 text-xs px-2.5 py-1 rounded-full">{expenseCategories[e.category] ?? e.category}</span></td>
              <td class="py-3 px-5 text-right text-red-400 font-medium">{e.amount.toLocaleString('nb-NO')} kr</td>
              <td class="py-3 px-5 text-right">
                <form method="POST" class="inline" onsubmit="return confirm('Slett denne utgiften?')">
                  <input type="hidden" name="action" value="delete_expense" />
                  <input type="hidden" name="id" value={e.id} />
                  <button type="submit" class="text-gray-600 hover:text-red-400 transition-colors text-xs">Slett</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot class="border-t-2 border-gray-700">
          <tr>
            <td colspan="3" class="py-3 px-5 text-gray-400 font-medium">Totalt</td>
            <td class="py-3 px-5 text-right font-bold text-red-400">{totalExpenses.toLocaleString('nb-NO')} kr</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  )}

  <!-- MVA-oversikt -->
  <h2 class="text-lg font-semibold mt-10 mb-4">MVA-oversikt {year} <span class="text-gray-500 text-sm font-normal">(fra betalte fakturaer)</span></h2>
  <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="border-b border-gray-800">
        <tr>
          <th class="text-left py-3 px-5 text-gray-400 font-medium">Periode</th>
          <th class="text-right py-3 px-5 text-gray-400 font-medium">Netto (eks. MVA)</th>
          <th class="text-right py-3 px-5 text-gray-400 font-medium">MVA (25%)</th>
          <th class="text-right py-3 px-5 text-gray-400 font-medium">Totalt inkl. MVA</th>
        </tr>
      </thead>
      <tbody>
        {vatByQuarter.map(q => (
          <tr class="border-b border-gray-800 last:border-0">
            <td class="py-3 px-5 font-medium">{q.label}</td>
            <td class="py-3 px-5 text-right text-gray-300">{q.net.toLocaleString('nb-NO')} kr</td>
            <td class="py-3 px-5 text-right text-yellow-400 font-medium">{q.mva.toLocaleString('nb-NO')} kr</td>
            <td class="py-3 px-5 text-right text-gray-300">{q.total.toLocaleString('nb-NO')} kr</td>
          </tr>
        ))}
      </tbody>
      <tfoot class="border-t-2 border-gray-700">
        <tr>
          <td class="py-3 px-5 font-medium text-gray-400">Årssum</td>
          <td class="py-3 px-5 text-right font-bold">{vatByQuarter.reduce((s, q) => s + q.net, 0).toLocaleString('nb-NO')} kr</td>
          <td class="py-3 px-5 text-right font-bold text-yellow-400">{vatByQuarter.reduce((s, q) => s + q.mva, 0).toLocaleString('nb-NO')} kr</td>
          <td class="py-3 px-5 text-right font-bold">{vatByQuarter.reduce((s, q) => s + q.total, 0).toLocaleString('nb-NO')} kr</td>
        </tr>
      </tfoot>
    </table>
  </div>
</AdminLayout>
