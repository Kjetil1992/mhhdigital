---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabase } from '../../../lib/supabase';

let errorMsg = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const file = data.get('receipt') as File | null;

  let receipt_url: string | null = null;

  if (file && file.size > 0) {
    const sb = getSupabase();
    const ext = file.name.split('.').pop() ?? 'bin';
    const filename = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
    const buffer = await file.arrayBuffer();

    const { error: uploadError } = await sb.storage
      .from('receipts')
      .upload(filename, buffer, { contentType: file.type, upsert: false });

    if (uploadError) {
      errorMsg = `Filopplasting feilet: ${uploadError.message}`;
    } else {
      const { data: urlData } = sb.storage.from('receipts').getPublicUrl(filename);
      receipt_url = urlData.publicUrl;
    }
  }

  if (!errorMsg) {
    const sb = getSupabase();
    const { error } = await sb.from('expenses').insert({
      description: data.get('description'),
      amount: Number(data.get('amount')),
      category: data.get('category'),
      date: data.get('date'),
      notes: data.get('notes') || null,
      receipt_url,
    });
    if (!error) return Astro.redirect('/admin/kvitteringer');
    errorMsg = error.message;
  }
}

const today = new Date().toISOString().split('T')[0];
---

<AdminLayout title="Last opp kvittering">
  <div class="max-w-xl">
    <div class="mb-8">
      <a href="/admin/kvitteringer" class="text-gray-500 hover:text-gray-300 text-sm transition-colors">← Kvitteringer</a>
      <h1 class="text-2xl font-bold mt-1">Last opp kvittering</h1>
      <p class="text-gray-400 text-sm mt-1">Kvitteringen lagres og oppretter en utgiftspost i regnskapet automatisk.</p>
    </div>

    {errorMsg && <div class="bg-red-950 border border-red-800 text-red-300 rounded-xl p-4 mb-6 text-sm">{errorMsg}</div>}

    <form method="POST" enctype="multipart/form-data" class="space-y-5">
      <!-- Filopplasting -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8">
        <h2 class="font-bold mb-4">Kvitteringsfil</h2>
        <label
          id="drop-label"
          class="flex flex-col items-center justify-center gap-3 border-2 border-dashed border-gray-700 hover:border-cyan-700 rounded-xl p-8 cursor-pointer transition-colors"
          ondragover="event.preventDefault();this.classList.add('border-cyan-500')"
          ondragleave="this.classList.remove('border-cyan-500')"
          ondrop="event.preventDefault();this.classList.remove('border-cyan-500');handleDrop(event)"
        >
          <span class="text-3xl">📎</span>
          <span class="text-gray-400 text-sm text-center">Dra og slipp kvittering her, eller klikk for å velge fil<br /><span class="text-xs text-gray-600">JPG, PNG, PDF · Maks 10 MB</span></span>
          <input
            id="receipt-input"
            type="file"
            name="receipt"
            accept="image/*,.pdf"
            class="hidden"
            onchange="handleFileSelect(this)"
          />
        </label>
        <div id="preview" class="hidden mt-4 flex items-center gap-3 bg-gray-800 rounded-xl px-4 py-3">
          <span id="preview-icon" class="text-xl">📄</span>
          <div class="flex-1 min-w-0">
            <p id="preview-name" class="text-sm font-medium truncate"></p>
            <p id="preview-size" class="text-xs text-gray-500 mt-0.5"></p>
          </div>
          <button type="button" onclick="clearFile()" class="text-gray-500 hover:text-red-400 transition-colors text-lg">×</button>
        </div>
        <div id="ai-loading" class="hidden mt-4 flex items-center gap-3 text-cyan-400 text-sm px-1">
          <span class="animate-spin inline-block">⏳</span>
          <span>Leser av kvittering med AI…</span>
        </div>
        <div id="ai-error" class="hidden mt-3 text-xs text-yellow-500 px-1"></div>
      </div>

      <!-- Utgiftsdetaljer -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 space-y-5">
        <h2 class="font-bold">Utgiftsdetaljer</h2>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Beskrivelse *</label>
          <input name="description" required placeholder="f.eks. Adobe Creative Cloud" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1.5">Beløp (kr) *</label>
            <input name="amount" type="number" min="0" step="0.01" required class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-300 mb-1.5">Dato *</label>
            <input name="date" type="date" required value={today} class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Kategori *</label>
          <select name="category" required class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500">
            <option value="programvare">Programvare</option>
            <option value="maskinvare">Maskinvare</option>
            <option value="kontor">Kontor</option>
            <option value="markedsforing">Markedsføring</option>
            <option value="reise">Reise</option>
            <option value="annet">Annet</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1.5">Notat</label>
          <textarea name="notes" rows="2" placeholder="Valgfritt — leverandør, hva det gjelder, etc." class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500 resize-none"></textarea>
        </div>
      </div>

      <div class="flex gap-3">
        <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-gray-950 font-bold px-6 py-2.5 rounded-xl transition-colors">Lagre kvittering</button>
        <a href="/admin/kvitteringer" class="text-gray-400 hover:text-white px-6 py-2.5 transition-colors">Avbryt</a>
      </div>
    </form>
  </div>
</AdminLayout>

<script is:inline>
  function showPreview(file) {
    const preview = document.getElementById('preview');
    const icon = document.getElementById('preview-icon');
    const name = document.getElementById('preview-name');
    const size = document.getElementById('preview-size');
    preview.classList.remove('hidden');
    icon.textContent = file.type.startsWith('image/') ? '🖼️' : '📄';
    name.textContent = file.name;
    size.textContent = (file.size / 1024).toFixed(0) + ' KB';
  }

  async function extractWithAI(file) {
    const loading = document.getElementById('ai-loading');
    const errEl = document.getElementById('ai-error');
    loading.classList.remove('hidden');
    errEl.classList.add('hidden');

    try {
      const fd = new FormData();
      fd.append('receipt', file);
      const res = await fetch('/api/kvitteringer/les-av', { method: 'POST', body: fd });
      if (!res.ok) throw new Error('Serverfeil');
      const data = await res.json();

      if (data.date) document.querySelector('[name="date"]').value = data.date;
      if (data.amount) document.querySelector('[name="amount"]').value = data.amount;
      if (data.description) document.querySelector('[name="description"]').value = data.description;
      if (data.notes) document.querySelector('[name="notes"]').value = data.notes;
      if (data.category) {
        const sel = document.querySelector('[name="category"]');
        const opt = [...sel.options].find(o => o.value === data.category);
        if (opt) sel.value = data.category;
      }
    } catch (e) {
      errEl.textContent = 'AI-avlesning feilet — fyll inn feltene manuelt.';
      errEl.classList.remove('hidden');
    } finally {
      loading.classList.add('hidden');
    }
  }

  function handleFileSelect(input) {
    const file = input.files?.[0];
    if (!file) return;
    showPreview(file);
    extractWithAI(file);
  }

  function clearFile() {
    const input = document.getElementById('receipt-input');
    input.value = '';
    document.getElementById('preview').classList.add('hidden');
    document.getElementById('ai-loading').classList.add('hidden');
    document.getElementById('ai-error').classList.add('hidden');
  }

  function handleDrop(event) {
    const input = document.getElementById('receipt-input');
    const dt = new DataTransfer();
    const file = event.dataTransfer.files[0];
    if (file) {
      dt.items.add(file);
      input.files = dt.files;
      handleFileSelect(input);
    }
  }

  document.getElementById('drop-label').addEventListener('click', function(e) {
    if (e.target === this || e.target.tagName !== 'INPUT') {
      document.getElementById('receipt-input').click();
    }
  });
</script>
