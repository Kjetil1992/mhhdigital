---
import { getSupabase } from '../../../../lib/supabase';
import { generateKID } from '../../../../lib/kid';

const KONTONUMMER = '4214 06 74421';

const { id } = Astro.params;
const sb = getSupabase();

const { data: inv } = await sb
  .from('invoices')
  .select('*, customers(*), invoice_lines(*)')
  .eq('id', id)
  .single();

if (!inv) return Astro.redirect('/admin/fakturaer');

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');

const subtotal = (inv.invoice_lines ?? []).reduce((s: number, l: any) => s + l.unit_price * l.quantity, 0);
const discountRate = (inv.discount ?? 0) / 100;
const discountAmount = subtotal * discountRate;
const total = subtotal - discountAmount;
const mvaRate = (inv.mva_rate ?? 0) / 100;
const mva = total * mvaRate;
const kid = generateKID(inv.invoice_number);

const S = {
  body: 'font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#000;padding:60px;max-width:800px;margin:0 auto;background:#fff;',
  label: 'font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;margin-bottom:8px;border-bottom:1px solid #000;padding-bottom:4px;display:block;',
  gray: 'color:#000;font-size:0.85rem;',
  metaVal: 'color:#000;font-size:0.9rem;',
  th: 'text-align:left;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-weight:700;font-size:0.8rem;text-transform:uppercase;color:#000;',
  thR: 'text-align:right;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-weight:700;font-size:0.8rem;text-transform:uppercase;color:#000;',
  td: 'padding:10px 0;border-bottom:1px solid #ccc;color:#000;',
  tdR: 'padding:10px 0;border-bottom:1px solid #ccc;color:#000;text-align:right;',
  payLabel: 'font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;margin-bottom:6px;',
  payValue: 'font-weight:700;font-size:1rem;font-family:monospace;color:#000;',
};
---

<!doctype html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="color-scheme" content="light" />
  <title>Faktura {inv.invoice_number}</title>
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    @page { margin: 0; size: A4; }
    @media print {
      .no-print { display: none !important; }
      body { padding: 15mm !important; }
    }
  </style>
</head>
<body style={S.body}>

  <div class="no-print" style="background:#f3f4f6;padding:12px 24px;margin:-60px -60px 40px;display:flex;justify-content:flex-end;">
    <button onclick="window.print()" style="background:#222;color:#fff;border:none;padding:8px 20px;border-radius:8px;font-weight:600;cursor:pointer;">
      Skriv ut / Lagre som PDF
    </button>
  </div>
  <script is:inline>
    if (new URLSearchParams(location.search).get('auto') === '1') {
      window.addEventListener('load', function() { window.print(); });
    }
  </script>

  <!-- Header -->
  <div style="display:flex;justify-content:space-between;margin-bottom:48px;">
    <div>
      <div style="font-size:1.5rem;font-weight:700;color:#000;">MHH Digital</div>
      <div style="color:#000;font-size:0.85rem;margin-top:6px;font-weight:600;">Hauan Digital</div>
      <div style={S.gray}>Org.nr: 937 888 309</div>
      <div style={S.gray}>Sandvikvegen 71D, 6030 Langevåg</div>
      <div style={S.gray}>kjetil@mhhdigital.no</div>
    </div>
    <div style="text-align:right;">
      <div style="font-size:1.3rem;font-weight:800;letter-spacing:0.05em;color:#000;">FAKTURA</div>
      <div style={S.metaVal}>{inv.invoice_number}</div>
      <div style={S.metaVal}>Dato: {new Date(inv.created_at).toLocaleDateString('nb-NO')}</div>
      {inv.due_date && <div style={S.metaVal}>Forfall: {new Date(inv.due_date).toLocaleDateString('nb-NO')}</div>}
    </div>
  </div>

  <!-- Faktureres til -->
  <div style="margin-bottom:40px;">
    <span style={S.label}>Faktureres til</span>
    <div style="font-size:1rem;font-weight:700;color:#000;margin-bottom:4px;">{inv.customers?.name}</div>
    {inv.customers?.email && <div style="font-size:0.9rem;color:#000;">{inv.customers.email}</div>}
    {inv.customers?.address && <div style="font-size:0.9rem;color:#000;white-space:pre-line;">{inv.customers.address}</div>}
    {inv.customers?.org_number && <div style="font-size:0.9rem;color:#000;">Org.nr: {inv.customers.org_number}</div>}
  </div>

  <!-- Tabell -->
  <table style="width:100%;border-collapse:collapse;margin-bottom:24px;font-size:0.9rem;">
    <thead>
      <tr>
        <th style={S.th}>Beskrivelse</th>
        <th style={S.thR}>Ant.</th>
        <th style={S.thR}>Pris</th>
        <th style={S.thR}>Sum</th>
      </tr>
    </thead>
    <tbody>
      {inv.invoice_lines.map((l: any) => (
        <tr>
          <td style={S.td}>{l.description}</td>
          <td style={S.tdR}>{l.quantity}</td>
          <td style={S.tdR}>{l.unit_price.toLocaleString('nb-NO')} kr</td>
          <td style={S.tdR}>{(l.unit_price * l.quantity).toLocaleString('nb-NO')} kr</td>
        </tr>
      ))}
    </tbody>
  </table>

  <!-- Totals -->
  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;font-size:0.9rem;margin-bottom:40px;">
    <div style="display:flex;gap:48px;color:#000;"><span>Subtotal</span><span>{subtotal.toLocaleString('nb-NO')} kr</span></div>
    {discountAmount > 0 && <div style="display:flex;gap:48px;color:#000;"><span>Rabatt ({inv.discount}%)</span><span>−{discountAmount.toLocaleString('nb-NO')} kr</span></div>}
    {discountAmount > 0 && <div style="display:flex;gap:48px;color:#000;"><span>Netto etter rabatt</span><span>{total.toLocaleString('nb-NO')} kr</span></div>}
    {!discountAmount && <div style="display:flex;gap:48px;color:#000;"><span>Netto</span><span>{total.toLocaleString('nb-NO')} kr</span></div>}
    {mva > 0 && <div style="display:flex;gap:48px;color:#000;"><span>MVA ({inv.mva_rate}%)</span><span>{mva.toLocaleString('nb-NO')} kr</span></div>}
    <div style="display:flex;gap:48px;font-weight:800;font-size:1rem;border-top:2px solid #000;padding-top:10px;margin-top:6px;color:#000;">
      <span>Totalt å betale</span><span>{(total + mva).toLocaleString('nb-NO', {minimumFractionDigits:2,maximumFractionDigits:2})} kr</span>
    </div>
  </div>

  <!-- Betalingsinformasjon -->
  <div style="border:2px solid #000;padding:20px 24px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;">
    <div>
      <div style={S.payLabel}>Kontonummer</div>
      <div style={S.payValue}>{KONTONUMMER}</div>
    </div>
    <div>
      <div style={S.payLabel}>KID</div>
      <div style={S.payValue}>{kid}</div>
    </div>
    <div>
      <div style={S.payLabel}>Beløp å betale</div>
      <div style="font-weight:800;font-size:1.1rem;color:#000;">{(total + mva).toLocaleString('nb-NO', {minimumFractionDigits:2,maximumFractionDigits:2})} kr</div>
    </div>
  </div>

  <!-- Notater -->
  {inv.notes && (
    <div style="margin-top:24px;padding:16px 20px;background:#f9f9f9;border-radius:8px;font-size:0.82rem;color:#000;white-space:pre-line;">
      {inv.notes}
    </div>
  )}

  <!-- Footer -->
  <div style="margin-top:48px;padding-top:16px;border-top:1px solid #ccc;font-size:0.8rem;text-align:center;color:#000;">
    Hauan Digital · Org.nr: 937 888 309 · Sandvikvegen 71D, 6030 Langevåg · kjetil@mhhdigital.no
  </div>

</body>
</html>
