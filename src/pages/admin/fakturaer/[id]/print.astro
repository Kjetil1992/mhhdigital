---
import { getSupabase } from '../../../../lib/supabase';
import { generateKID } from '../../../../lib/kid';

const KONTONUMMER = '4214 06 74421';

const { id } = Astro.params;
const sb = getSupabase();

const { data: inv } = await sb
  .from('invoices')
  .select('*, customers(*), invoice_lines(*)')
  .eq('id', id)
  .single();

if (!inv) return Astro.redirect('/admin/fakturaer');

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');

const total = (inv.invoice_lines ?? []).reduce((s: number, l: any) => s + l.unit_price * l.quantity, 0);
const mvaRate = (inv.mva_rate ?? 0) / 100;
const mva = total * mvaRate;
const kid = generateKID(inv.invoice_number);
---

<!doctype html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="color-scheme" content="light" />
  <title>Faktura {inv.invoice_number}</title>
  <style>
    :root { color-scheme: light only; }
    * { box-sizing: border-box; margin: 0; padding: 0; color: #000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    body { padding: 60px; max-width: 800px; margin: 0 auto; background: #fff; }
    .no-print { background: #f3f4f6; padding: 12px 24px; margin: -60px -60px 40px; display: flex; justify-content: flex-end; }
    .header { display: flex; justify-content: space-between; margin-bottom: 48px; }
    .logo { font-size: 1.5rem; font-weight: 700; }
    .logo-accent { color: #0891b2; }
    .contact { font-size: 0.85rem; margin-top: 4px; line-height: 1.6; }
    .meta { text-align: right; font-size: 0.9rem; line-height: 1.8; }
    .meta h2 { font-size: 1.3rem; font-weight: 800; letter-spacing: 0.05em; }
    .section-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 8px; border-bottom: 1px solid #000; padding-bottom: 4px; }
    .bill-to { margin-bottom: 40px; }
    .bill-to .name { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
    .bill-to .detail { font-size: 0.9rem; line-height: 1.6; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 0.9rem; }
    th { text-align: left; padding: 8px 0; border-top: 2px solid #000; border-bottom: 2px solid #000; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
    th:not(:first-child), td:not(:first-child) { text-align: right; }
    td { padding: 10px 0; border-bottom: 1px solid #ccc; }
    .totals { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; font-size: 0.9rem; margin-bottom: 40px; }
    .totals-row { display: flex; gap: 48px; }
    .totals-row.grand { font-weight: 800; font-size: 1rem; border-top: 2px solid #000; padding-top: 10px; margin-top: 6px; }
    .payment { border: 2px solid #000; padding: 20px 24px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
    .payment-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 6px; }
    .payment-value { font-weight: 700; font-size: 1rem; font-family: monospace; }
    .payment-value.amount { font-size: 1.1rem; font-weight: 800; font-family: inherit; }
    .footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid #ccc; font-size: 0.8rem; text-align: center; }
    @media print {
      body { padding: 20px; }
      .no-print { display: none; }
    }
  </style>
</head>
<body>

  <div class="no-print">
    <button onclick="window.print()" style="background:#0891b2;color:#fff;border:none;padding:8px 20px;border-radius:8px;font-weight:600;cursor:pointer;">
      Skriv ut / Lagre som PDF
    </button>
  </div>
  <script is:inline>
    function forceBlackAndPrint() {
      document.querySelectorAll('*').forEach(function(el) {
        if (!el.classList.contains('logo-accent') && !el.classList.contains('no-print')) {
          el.style.setProperty('color', '#000', 'important');
        }
      });
      window.print();
    }
    if (new URLSearchParams(location.search).get('auto') === '1') {
      window.addEventListener('load', forceBlackAndPrint);
    }
  </script>

  <div class="header">
    <div>
      <div class="logo">MHH<span class="logo-accent">Digital</span></div>
      <div class="contact">
        kjetil@mhhdigital.no<br/>
        www.mhhdigital.no
      </div>
    </div>
    <div class="meta">
      <h2>FAKTURA</h2>
      <div>{inv.invoice_number}</div>
      <div>Dato: {new Date(inv.created_at).toLocaleDateString('nb-NO')}</div>
      {inv.due_date && <div>Forfall: {new Date(inv.due_date).toLocaleDateString('nb-NO')}</div>}
    </div>
  </div>

  <div class="bill-to">
    <div class="section-label">Faktureres til</div>
    <div class="name">{inv.customers?.name}</div>
    <div class="detail">
      {inv.customers?.email && <div>{inv.customers.email}</div>}
      {inv.customers?.address && <div style="white-space:pre-line">{inv.customers.address}</div>}
      {inv.customers?.org_number && <div>Org.nr: {inv.customers.org_number}</div>}
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Beskrivelse</th>
        <th>Ant.</th>
        <th>Pris</th>
        <th>Sum</th>
      </tr>
    </thead>
    <tbody>
      {inv.invoice_lines.map((l: any) => (
        <tr>
          <td>{l.description}</td>
          <td>{l.quantity}</td>
          <td>{l.unit_price.toLocaleString('nb-NO')} kr</td>
          <td>{(l.unit_price * l.quantity).toLocaleString('nb-NO')} kr</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="totals">
    <div class="totals-row"><span>Netto</span><span>{total.toLocaleString('nb-NO')} kr</span></div>
    {mva > 0 && <div class="totals-row"><span>MVA ({inv.mva_rate}%)</span><span>{mva.toLocaleString('nb-NO')} kr</span></div>}
    <div class="totals-row grand"><span>Totalt å betale</span><span>{(total + mva).toLocaleString('nb-NO')} kr</span></div>
  </div>

  <div class="payment">
    <div>
      <div class="payment-label">Kontonummer</div>
      <div class="payment-value">{KONTONUMMER}</div>
    </div>
    <div>
      <div class="payment-label">KID</div>
      <div class="payment-value">{kid}</div>
    </div>
    <div>
      <div class="payment-label">Beløp å betale</div>
      <div class="payment-value amount">{(total + mva).toLocaleString('nb-NO')} kr</div>
    </div>
  </div>

  <div class="footer">MHH Digital · kjetil@mhhdigital.no · www.mhhdigital.no</div>

</body>
</html>
