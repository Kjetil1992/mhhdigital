---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabase } from '../../../lib/supabase';
import { generateKID } from '../../../lib/kid';

const KONTONUMMER = '4214 06 74421';

const { id } = Astro.params;
const sb = getSupabase();

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');
  if (action === 'update_status') {
    await sb.from('invoices').update({ status: data.get('status') }).eq('id', id);
    return Astro.redirect(`/admin/fakturaer/${id}`);
  }
  if (action === 'delete') {
    await sb.from('invoice_lines').delete().eq('invoice_id', id);
    await sb.from('invoices').delete().eq('id', id);
    return Astro.redirect('/admin/fakturaer');
  }
  return Astro.redirect(`/admin/fakturaer/${id}`);
}

const { data: inv } = await sb
  .from('invoices')
  .select('*, customers(*), projects(name), invoice_lines(*)')
  .eq('id', id)
  .single();

if (!inv) return Astro.redirect('/admin/fakturaer');

const subtotal = (inv.invoice_lines ?? []).reduce((s: number, l: any) => s + l.unit_price * l.quantity, 0);
const discountRate = (inv.discount ?? 0) / 100;
const discountAmount = subtotal * discountRate;
const total = subtotal - discountAmount;
const mvaRate = (inv.mva_rate ?? 0) / 100;
const mva = total * mvaRate;
const kid = generateKID(inv.invoice_number);

const statusLabel: Record<string, string> = { kladd: 'Kladd', sendt: 'Sendt', betalt: 'Betalt' };
const sent = Astro.url.searchParams.get('sent') === '1';
const emailError = Astro.url.searchParams.get('error');
---

<AdminLayout title={`Faktura ${inv.invoice_number}`}>
  <div class="max-w-2xl">

    <div class="mb-6">
      <h1 class="text-2xl font-bold">{inv.invoice_number}</h1>
      <p class="text-gray-400 text-sm mt-1">Status: {statusLabel[inv.status]}</p>
    </div>

    <div class="flex flex-wrap gap-3 mb-8">
      <a href={`/admin/fakturaer/${id}/print?auto=1&t=${Date.now()}`} target="_blank" class="border border-gray-700 hover:border-gray-500 text-gray-300 font-semibold px-4 py-2 rounded-xl transition-colors text-sm">
        ⬇ Last ned PDF
      </a>
      <form method="POST" onsubmit="return confirm('Slett denne fakturaen? Dette kan ikke angres.')">
        <input type="hidden" name="action" value="delete" />
        <button type="submit" class="border border-red-900 hover:border-red-700 text-red-400 hover:text-red-300 font-semibold px-4 py-2 rounded-xl transition-colors text-sm">
          Slett
        </button>
      </form>
      <form method="POST" class="flex gap-2">
        <input type="hidden" name="action" value="update_status" />
        <select name="status" class="bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm focus:outline-none focus:border-cyan-500">
          <option value="kladd" selected={inv.status === 'kladd'}>Kladd</option>
          <option value="sendt" selected={inv.status === 'sendt'}>Sendt</option>
          <option value="betalt" selected={inv.status === 'betalt'}>Betalt</option>
        </select>
        <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-gray-950 font-bold px-4 py-2 rounded-xl transition-colors text-sm">Oppdater</button>
      </form>
    </div>

    {sent && <div class="bg-green-950 border border-green-800 text-green-400 rounded-xl px-5 py-3 text-sm mb-6">Faktura sendt til {inv.customers?.email}</div>}
    {emailError === 'send-failed' && <div class="bg-red-950 border border-red-800 text-red-300 rounded-xl px-5 py-3 text-sm mb-6">Kunne ikke sende e-post.</div>}
    {emailError === 'no-email' && <div class="bg-red-950 border border-red-800 text-red-300 rounded-xl px-5 py-3 text-sm mb-6">Kunden mangler e-postadresse.</div>}

    <!-- Invoice preview: white background, all black text -->
    <div style="background:#fff;color:#000;border-radius:12px;padding:40px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:0.9rem;">

      <div style="display:flex;justify-content:space-between;margin-bottom:40px;">
        <div>
          <div style="font-size:1.3rem;font-weight:800;color:#000;">MHHDigital</div>
          <div style="color:#000;font-size:0.85rem;">kjetil@mhhdigital.no</div>
          <div style="color:#000;font-size:0.85rem;">www.mhhdigital.no</div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:1.1rem;font-weight:800;letter-spacing:0.05em;color:#000;">FAKTURA</div>
          <div style="color:#000;">{inv.invoice_number}</div>
          <div style="color:#000;">Dato: {new Date(inv.created_at).toLocaleDateString('nb-NO')}</div>
          {inv.due_date && <div style="color:#000;">Forfall: {new Date(inv.due_date).toLocaleDateString('nb-NO')}</div>}
        </div>
      </div>

      <div style="margin-bottom:32px;">
        <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;border-bottom:1px solid #000;padding-bottom:4px;margin-bottom:8px;">Faktureres til</div>
        <div style="font-weight:700;color:#000;">{inv.customers?.name}</div>
        {inv.customers?.email && <div style="color:#000;font-size:0.85rem;">{inv.customers.email}</div>}
        {inv.customers?.address && <div style="color:#000;font-size:0.85rem;white-space:pre-line;">{inv.customers.address}</div>}
        {inv.customers?.org_number && <div style="color:#000;font-size:0.85rem;">Org.nr: {inv.customers.org_number}</div>}
      </div>

      <table style="width:100%;border-collapse:collapse;margin-bottom:20px;">
        <thead>
          <tr>
            <th style="text-align:left;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-size:0.8rem;text-transform:uppercase;color:#000;">Beskrivelse</th>
            <th style="text-align:right;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-size:0.8rem;text-transform:uppercase;color:#000;">Ant.</th>
            <th style="text-align:right;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-size:0.8rem;text-transform:uppercase;color:#000;">Pris</th>
            <th style="text-align:right;padding:8px 0;border-top:2px solid #000;border-bottom:2px solid #000;font-size:0.8rem;text-transform:uppercase;color:#000;">Sum</th>
          </tr>
        </thead>
        <tbody>
          {inv.invoice_lines.map((l: any) => (
            <tr>
              <td style="padding:10px 0;border-bottom:1px solid #ccc;color:#000;">{l.description}</td>
              <td style="padding:10px 0;border-bottom:1px solid #ccc;color:#000;text-align:right;">{l.quantity}</td>
              <td style="padding:10px 0;border-bottom:1px solid #ccc;color:#000;text-align:right;">{l.unit_price.toLocaleString('nb-NO')} kr</td>
              <td style="padding:10px 0;border-bottom:1px solid #ccc;color:#000;text-align:right;">{(l.unit_price * l.quantity).toLocaleString('nb-NO')} kr</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;margin-bottom:32px;font-size:0.9rem;">
        <div style="display:flex;gap:48px;color:#000;"><span>Subtotal</span><span>{subtotal.toLocaleString('nb-NO')} kr</span></div>
        {discountAmount > 0 && <div style="display:flex;gap:48px;color:#000;"><span>Rabatt ({inv.discount}%)</span><span>−{discountAmount.toLocaleString('nb-NO')} kr</span></div>}
        {discountAmount > 0 && <div style="display:flex;gap:48px;color:#000;"><span>Netto etter rabatt</span><span>{total.toLocaleString('nb-NO')} kr</span></div>}
        {!discountAmount && <div style="display:flex;gap:48px;color:#000;"><span>Netto</span><span>{total.toLocaleString('nb-NO')} kr</span></div>}
        {mva > 0 && <div style="display:flex;gap:48px;color:#000;"><span>MVA ({inv.mva_rate}%)</span><span>{mva.toLocaleString('nb-NO')} kr</span></div>}
        <div style="display:flex;gap:48px;font-weight:800;font-size:1rem;border-top:2px solid #000;padding-top:10px;margin-top:6px;color:#000;">
          <span>Totalt å betale</span><span>{(total + mva).toLocaleString('nb-NO')} kr</span>
        </div>
      </div>

      <div style="border:2px solid #000;padding:16px 20px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;">
        <div>
          <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;margin-bottom:4px;">Kontonummer</div>
          <div style="font-family:monospace;font-weight:700;color:#000;">{KONTONUMMER}</div>
        </div>
        <div>
          <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;margin-bottom:4px;">KID</div>
          <div style="font-family:monospace;font-weight:700;color:#000;">{kid}</div>
        </div>
        <div>
          <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;margin-bottom:4px;">Beløp å betale</div>
          <div style="font-weight:800;font-size:1rem;color:#000;">{(total + mva).toLocaleString('nb-NO', {minimumFractionDigits:2,maximumFractionDigits:2})} kr</div>
        </div>
      </div>

      <div style="margin-top:40px;padding-top:16px;border-top:1px solid #ccc;font-size:0.8rem;text-align:center;color:#000;">
        MHH Digital · kjetil@mhhdigital.no · www.mhhdigital.no
      </div>

    </div>

  </div>
</AdminLayout>
