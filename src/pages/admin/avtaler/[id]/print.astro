---
import { getSupabase } from '../../../../lib/supabase';

const { id } = Astro.params;
const sb = getSupabase();

const { data: agreement } = await sb
  .from('agreements')
  .select('*, customers(*)')
  .eq('id', id)
  .single();

if (!agreement) return Astro.redirect('/admin/avtaler');

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');

const intervalLabel: Record<string, string> = {
  monthly: 'per måned',
  yearly: 'per år',
  once: 'engangs',
};

const typeLabel: Record<string, string> = {
  vedlikehold: 'Vedlikeholdsavtale',
  nettside: 'Nettside',
  annet: 'Avtale',
};

const startFormatted = agreement.start_date
  ? new Date(agreement.start_date).toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const todayFormatted = new Date().toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="no">
<head>
  <meta charset="UTF-8" />
  <meta name="color-scheme" content="light" />
  <title>Avtale – {agreement.title}</title>
  <style is:global>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    @page { margin: 0; size: A4; }
    @media print {
      .no-print { display: none !important; }
      body { padding: 12mm 14mm !important; font-size: 0.78rem !important; }
    }
  </style>
</head>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#000;padding:32px 40px;max-width:800px;margin:0 auto;background:#fff;font-size:0.82rem;">

  <div class="no-print" style="background:#f3f4f6;padding:12px 24px;margin:-60px -60px 40px;display:flex;justify-content:flex-end;">
    <button onclick="window.print()" style="background:#222;color:#fff;border:none;padding:8px 20px;border-radius:8px;font-weight:600;cursor:pointer;">
      Skriv ut / Lagre som PDF
    </button>
  </div>
  <script is:inline>
    if (new URLSearchParams(location.search).get('auto') === '1') {
      window.addEventListener('load', function() { window.print(); });
    }
  </script>

  <!-- Header -->
  <div style="display:flex;justify-content:space-between;margin-bottom:20px;">
    <div>
      <div style="font-size:1.2rem;font-weight:700;color:#000;">MHH Digital</div>
      <div style="color:#000;font-size:0.78rem;margin-top:3px;font-weight:600;">Hauan Digital</div>
      <div style="color:#000;font-size:0.78rem;">Org.nr: 937 888 309</div>
      <div style="color:#000;font-size:0.78rem;">Sandvikvegen 71D, 6030 Langevåg</div>
      <div style="color:#000;font-size:0.78rem;">kjetil@mhhdigital.no</div>
    </div>
    <div style="text-align:right;">
      <div style="font-size:1.1rem;font-weight:800;letter-spacing:0.05em;color:#000;">{typeLabel[agreement.type] ?? 'AVTALE'}</div>
      <div style="color:#000;font-size:0.82rem;margin-top:3px;">Dato: {todayFormatted}</div>
      {startFormatted && <div style="color:#000;font-size:0.82rem;">Startdato: {startFormatted}</div>}
      <div style="color:#000;font-size:0.82rem;margin-top:4px;">Status: <span style="font-weight:600;">{agreement.status.charAt(0).toUpperCase() + agreement.status.slice(1)}</span></div>
    </div>
  </div>

  <!-- Parter -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:16px;">
    <div>
      <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;border-bottom:1px solid #000;padding-bottom:3px;margin-bottom:6px;">Leverandør</div>
      <div style="font-weight:700;color:#000;">Hauan Digital</div>
      <div style="color:#000;font-size:0.78rem;">Org.nr: 937 888 309</div>
      <div style="color:#000;font-size:0.78rem;">Sandvikvegen 71D, 6030 Langevåg</div>
      <div style="color:#000;font-size:0.78rem;">kjetil@mhhdigital.no</div>
    </div>
    <div>
      <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;border-bottom:1px solid #000;padding-bottom:3px;margin-bottom:6px;">Kunde</div>
      {agreement.customers ? (
        <>
          <div style="font-weight:700;color:#000;">{agreement.customers.name}</div>
          {agreement.customers.email && <div style="color:#000;font-size:0.78rem;">{agreement.customers.email}</div>}
          {agreement.customers.address && <div style="color:#000;font-size:0.78rem;white-space:pre-line;">{agreement.customers.address}</div>}
          {agreement.customers.org_number && <div style="color:#000;font-size:0.78rem;">Org.nr: {agreement.customers.org_number}</div>}
        </>
      ) : (
        <div style="color:#666;font-size:0.78rem;">Ingen kunde registrert</div>
      )}
    </div>
  </div>

  <!-- Avtaletittel og pris -->
  <div style="border:2px solid #000;padding:12px 16px;margin-bottom:16px;display:flex;align-items:baseline;justify-content:space-between;">
    <div style="font-size:1rem;font-weight:800;color:#000;">{agreement.title}</div>
    <div style="text-align:right;">
      <span style="font-size:1.2rem;font-weight:800;color:#000;">{Number(agreement.price).toLocaleString('nb-NO')} kr</span>
      {agreement.billing_interval !== 'once' && <span style="font-size:0.8rem;font-weight:400;color:#000;"> {intervalLabel[agreement.billing_interval]}</span>}
      <div style="color:#555;font-size:0.72rem;">eks. MVA</div>
    </div>
  </div>

  <!-- Innhold/notater -->
  {agreement.notes && (
    <div style="margin-bottom:16px;">
      <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;font-weight:700;color:#000;border-bottom:1px solid #000;padding-bottom:3px;margin-bottom:8px;">Avtalens innhold</div>
      <div style="font-size:0.8rem;color:#000;white-space:pre-line;line-height:1.55;">{agreement.notes}</div>
    </div>
  )}

  <!-- Underskrift -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:24px;">
    <div>
      <div style="border-top:1px solid #000;padding-top:6px;margin-top:36px;">
        <div style="font-size:0.75rem;color:#000;">Dato og underskrift – Leverandør</div>
        <div style="font-size:0.78rem;color:#000;margin-top:3px;">Hauan Digital</div>
      </div>
    </div>
    <div>
      <div style="border-top:1px solid #000;padding-top:6px;margin-top:36px;">
        <div style="font-size:0.75rem;color:#000;">Dato og underskrift – Kunde</div>
        {agreement.customers && <div style="font-size:0.78rem;color:#000;margin-top:3px;">{agreement.customers.name}</div>}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div style="margin-top:20px;padding-top:10px;border-top:1px solid #ccc;font-size:0.72rem;text-align:center;color:#000;">
    Hauan Digital · Org.nr: 937 888 309 · Sandvikvegen 71D, 6030 Langevåg · kjetil@mhhdigital.no
  </div>

</body>
</html>
