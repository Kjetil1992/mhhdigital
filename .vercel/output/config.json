{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/fakturaer/ny/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/fakturaer/([^/]+?)/print/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/fakturaer/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/fakturaer/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/kunder/ny/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/kunder/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/prosjekter/ny/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/prosjekter/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/kontakt/?$",
			"dest": "_render"
		},
		{
			"src": "^/om-oss/?$",
			"dest": "_render"
		},
		{
			"src": "^/personvern/?$",
			"dest": "_render"
		},
		{
			"src": "^/portfolio/?$",
			"dest": "_render"
		},
		{
			"src": "^/stotte/?$",
			"dest": "_render"
		},
		{
			"src": "^/strikkepinnen/stotte/?$",
			"dest": "_render"
		},
		{
			"src": "^/tjenester/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}